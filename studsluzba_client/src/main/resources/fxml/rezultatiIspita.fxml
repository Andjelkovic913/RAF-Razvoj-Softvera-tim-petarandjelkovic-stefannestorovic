<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.raflab.studsluzbadesktopclient.controllers.RezultatiIspitaController">
    <top>
        <fx:include source="menuBar.fxml"/>
    </top>
    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Rezultati ispita:" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="← Nazad na ispite" onAction="#handleBackToIspiti"/>
            </HBox>
            
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Ispitni rok:"/>
                <ComboBox fx:id="ispitniRokComboBox" promptText="Izaberite ispitni rok" prefWidth="300" onAction="#handleIspitniRokSelected"/>
                <Button text="✕" onAction="#handleClearIspitniRok" style="-fx-font-size: 14px;" prefWidth="30"/>
            </HBox>
            
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Ispit:"/>
                <ComboBox fx:id="ispitComboBox" promptText="Izaberite ispit" prefWidth="400" onAction="#handleIspitSelected"/>
                <Button text="✕" onAction="#handleClearIspit" style="-fx-font-size: 14px;" prefWidth="30"/>
            </HBox>
            
            <!-- Result entry form -->
            <TitledPane text="Unos rezultata za studenta" expanded="true">
                <GridPane hgap="10" vgap="10">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                    
                    <Label text="Student:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="studentCb" prefWidth="350" GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.columnSpan="3"/>
                    
                    <Label text="Predispitni poeni:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="predispitniPoeniTf" prefWidth="80" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    
                    <Label text="Ispitni poeni:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <TextField fx:id="ispitniPoeniTf" prefWidth="80" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                    
                    <Label text="Ocena:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <ComboBox fx:id="ocenaCb" prefWidth="80" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    
                    <Label text="Poništio:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                    <CheckBox fx:id="ponistioCb" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                    
                    <Label text="Napomena:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <TextField fx:id="napomenaTf" prefWidth="350" GridPane.columnIndex="1" GridPane.rowIndex="3" GridPane.columnSpan="3"/>
                    
                    <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="4">
                        <Button text="Sačuvaj rezultat" onAction="#handleSaveResult" 
                                style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                        <Button text="Očisti" onAction="#handleClearForm"/>
                    </HBox>
                </GridPane>
            </TitledPane>
            
            <!-- Table of exam results -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Rezultati ispita (sortirano po programu → godini → broju indeksa)" 
                       style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
            </HBox>
            
            <TableView fx:id="rezultatiTable" VBox.vgrow="ALWAYS" minHeight="250">
                <columns>
                    <TableColumn fx:id="indeksColumn" prefWidth="100" text="Indeks">
                        <cellValueFactory>
                            <PropertyValueFactory property="fullStudentInfo"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="predispitniColumn" prefWidth="100" text="Predispitni">
                        <cellValueFactory>
                            <PropertyValueFactory property="osvojeniPredispitniPoeni"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="ispitniColumn" prefWidth="100" text="Ispitni">
                        <cellValueFactory>
                            <PropertyValueFactory property="osvojeniIspitniPoeni"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="ukupnoColumn" prefWidth="80" text="Ukupno">
                        <cellValueFactory>
                            <PropertyValueFactory property="ukupnoPoena"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="ocenaColumn" prefWidth="60" text="Ocena">
                        <cellValueFactory>
                            <PropertyValueFactory property="ocena"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="ponistioColumn" prefWidth="70" text="Poništio">
                        <cellValueFactory>
                            <PropertyValueFactory property="ponistio"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="napomenaColumn" prefWidth="150" text="Napomena">
                        <cellValueFactory>
                            <PropertyValueFactory property="napomena"/>
                        </cellValueFactory>
                    </TableColumn>
                </columns>
            </TableView>
            
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Osveži listu" onAction="#handleRefresh"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
