<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.raflab.studsluzbadesktopclient.controllers.PredmetViewController"
            prefHeight="600.0" prefWidth="900.0">

    <top>
        <VBox spacing="0">
            <fx:include source="menuBar.fxml"/>
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 10 20 10 20; -fx-background-color: #f5f5f5;">
                <Label text="Predmeti po studijskim programima" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10 15 10 15;">
                <Label text="Studijski program:"/>
                <ComboBox fx:id="studProgramCb" prefWidth="300" promptText="Izaberite studijski program"/>
                <CheckBox fx:id="obavezniCheckBox" text="Samo obavezni predmeti"/>
                <Button text="Učitaj predmete" onAction="#handleLoadPredmeti" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                <Button text="Štampaj izveštaj" onAction="#handlePrintReport" style="-fx-background-color: #FF9800; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <VBox fx:id="predmetiContainer" spacing="15" style="-fx-padding: 15;"/>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 15;">
            <Button text="Dodaj novi predmet" onAction="#handleAddPredmet" style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
            <!-- <Button text="Izmeni predmet" onAction="#handleEditPredmet" disable="true" fx:id="editBtn"/> -->
            <!-- <Button text="Obriši predmet" onAction="#handleDeletePredmet" disable="true" fx:id="deleteBtn"/> -->
            <Button text="Osveži" onAction="#handleRefresh"/>
        </HBox>
    </bottom>

</BorderPane>
