<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="uverenjeOPolozenimIspitima"
              pageWidth="595"
              pageHeight="842"
              columnWidth="535"
              leftMargin="30"
              rightMargin="30"
              topMargin="30"
              bottomMargin="30">

    <parameter name="studentIme" class="java.lang.String"/>
    <parameter name="studentPrezime" class="java.lang.String"/>
    <parameter name="brojIndeksa" class="java.lang.String"/>
    <parameter name="studijskiProgram" class="java.lang.String"/>
    <parameter name="ukupnoEspb" class="java.lang.Integer"/>
    <parameter name="prosecnaOcena" class="java.lang.Double"/>
    <parameter name="brojPredmeta" class="java.lang.Integer"/>

    <field name="predmetNaziv" class="java.lang.String"/>
    <field name="espb" class="java.lang.Integer"/>
    <field name="ocena" class="java.lang.Integer"/>
    <field name="datumPolaganja" class="java.time.LocalDate"/>

    <variable name="sumEspb" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{espb}]]></variableExpression>
    </variable>
    <variable name="avgOcena" class="java.lang.Double" calculation="Average">
        <variableExpression><![CDATA[$F{ocena}]]></variableExpression>
    </variable>

    <title>
        <band height="180">
            <staticText>
                <reportElement x="0" y="0" width="535" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="16" isBold="true" pdfEncoding="UTF-8"/>
                </textElement>
                <text><![CDATA[RAČUNARSKI FAKULTET]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="25" width="535" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="12" pdfEncoding="UTF-8"/>
                </textElement>
                <text><![CDATA[Univerzitet Union]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="55" width="535" height="1"/>
            </line>
            <staticText>
                <reportElement x="0" y="65" width="535" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="14" isBold="true" pdfEncoding="UTF-8"/>
                </textElement>
                <text><![CDATA[UVERENJE O POLOŽENIM ISPITIMA]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="95" width="535" height="1"/>
            </line>
            
            <staticText>
                <reportElement x="0" y="110" width="80" height="20"/>
                <textElement><font fontName="DejaVu Sans" size="11" pdfEncoding="UTF-8"/></textElement>
                <text><![CDATA[Student:]]></text>
            </staticText>
            <textField>
                <reportElement x="80" y="110" width="400" height="20"/>
                <textElement><font fontName="DejaVu Sans" size="11" isBold="true" pdfEncoding="UTF-8"/></textElement>
                <textFieldExpression><![CDATA[$P{studentIme} + " " + $P{studentPrezime}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="0" y="130" width="80" height="20"/>
                <textElement><font fontName="DejaVu Sans" size="11" pdfEncoding="UTF-8"/></textElement>
                <text><![CDATA[Indeks:]]></text>
            </staticText>
            <textField>
                <reportElement x="80" y="130" width="150" height="20"/>
                <textElement><font fontName="DejaVu Sans" size="11" isBold="true" pdfEncoding="UTF-8"/></textElement>
                <textFieldExpression><![CDATA[$P{brojIndeksa}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="0" y="150" width="80" height="20"/>
                <textElement><font fontName="DejaVu Sans" size="11" pdfEncoding="UTF-8"/></textElement>
                <text><![CDATA[Program:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="80" y="150" width="300" height="20"/>
                <textElement><font fontName="DejaVu Sans" size="11" pdfEncoding="UTF-8"/></textElement>
                <textFieldExpression><![CDATA[$P{studijskiProgram}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="25">
            <staticText>
                <reportElement mode="Opaque" x="0" y="0" width="280" height="25" backcolor="#E0E0E0"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true" pdfEncoding="UTF-8"/>
                </textElement>
                <text><![CDATA[Predmet]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="280" y="0" width="60" height="25" backcolor="#E0E0E0"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true" pdfEncoding="UTF-8"/>
                </textElement>
                <text><![CDATA[ESPB]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="340" y="0" width="60" height="25" backcolor="#E0E0E0"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true" pdfEncoding="UTF-8"/>
                </textElement>
                <text><![CDATA[Ocena]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="400" y="0" width="135" height="25" backcolor="#E0E0E0"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true" pdfEncoding="UTF-8"/>
                </textElement>
                <text><![CDATA[Datum polaganja]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="280" height="20"/>
                <box leftPadding="5">
                    <pen lineWidth="0.5"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" pdfEncoding="UTF-8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{predmetNaziv}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="280" y="0" width="60" height="20"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" pdfEncoding="UTF-8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{espb}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="340" y="0" width="60" height="20"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" pdfEncoding="UTF-8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{ocena}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="400" y="0" width="135" height="20"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" pdfEncoding="UTF-8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{datumPolaganja} != null ? $F{datumPolaganja}.format(java.time.format.DateTimeFormatter.ofPattern("dd.MM.yyyy.")) : ""]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="160">
            <line>
                <reportElement x="0" y="5" width="535" height="1"/>
            </line>
            <staticText>
                <reportElement x="0" y="15" width="200" height="20"/>
                <textElement><font fontName="DejaVu Sans" size="11" isBold="true" pdfEncoding="UTF-8"/></textElement>
                <text><![CDATA[UKUPNO POLOŽENO:]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="0" y="40" width="120" height="20"/>
                <textElement><font fontName="DejaVu Sans" size="10" pdfEncoding="UTF-8"/></textElement>
                <text><![CDATA[Broj predmeta:]]></text>
            </staticText>
            <textField>
                <reportElement x="120" y="40" width="100" height="20"/>
                <textElement><font fontName="DejaVu Sans" size="10" isBold="true" pdfEncoding="UTF-8"/></textElement>
                <textFieldExpression><![CDATA[$P{brojPredmeta}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="0" y="60" width="120" height="20"/>
                <textElement><font fontName="DejaVu Sans" size="10" pdfEncoding="UTF-8"/></textElement>
                <text><![CDATA[Ukupno ESPB:]]></text>
            </staticText>
            <textField>
                <reportElement x="120" y="60" width="100" height="20"/>
                <textElement><font fontName="DejaVu Sans" size="10" isBold="true" pdfEncoding="UTF-8"/></textElement>
                <textFieldExpression><![CDATA[$P{ukupnoEspb}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="0" y="80" width="120" height="20"/>
                <textElement><font fontName="DejaVu Sans" size="10" pdfEncoding="UTF-8"/></textElement>
                <text><![CDATA[PROSEČNA OCENA:]]></text>
            </staticText>
            <textField>
                <reportElement x="120" y="80" width="100" height="20"/>
                <textElement><font fontName="DejaVu Sans" size="10" isBold="true" pdfEncoding="UTF-8"/></textElement>
                <textFieldExpression><![CDATA[$P{prosecnaOcena} != null ? String.format("%.2f", $P{prosecnaOcena}) : "-"]]></textFieldExpression>
            </textField>
            
            <line>
                <reportElement x="0" y="110" width="535" height="1"/>
            </line>
            
            <staticText>
                <reportElement x="0" y="120" width="80" height="20"/>
                <textElement><font fontName="DejaVu Sans" size="10" pdfEncoding="UTF-8"/></textElement>
                <text><![CDATA[U Beogradu,]]></text>
            </staticText>
            <textField>
                <reportElement x="70" y="120" width="150" height="20"/>
                <textElement><font fontName="DejaVu Sans" size="10" pdfEncoding="UTF-8"/></textElement>
                <textFieldExpression><![CDATA[new java.text.SimpleDateFormat("dd.MM.yyyy.").format(new java.util.Date())]]></textFieldExpression>
            </textField>
            
            <line>
                <reportElement x="350" y="130" width="185" height="1"/>
            </line>
            <staticText>
                <reportElement x="350" y="132" width="185" height="15"/>
                <textElement textAlignment="Center"><font fontName="DejaVu Sans" size="9" pdfEncoding="UTF-8"/></textElement>
                <text><![CDATA[Studentska služba]]></text>
            </staticText>
        </band>
    </summary>

</jasperReport>