<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="zapisnikIspita" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    
    <parameter name="predmetNaziv" class="java.lang.String"/>
    <parameter name="datumIspita" class="java.lang.String"/>
    <parameter name="ispitniRok" class="java.lang.String"/>
    
    <field name="brojIndeksa" class="java.lang.Integer"/>
    <field name="godinaIndeksa" class="java.lang.Integer"/>
    <field name="studProgramOznaka" class="java.lang.String"/>
    <field name="studentIme" class="java.lang.String"/>
    <field name="studentPrezime" class="java.lang.String"/>
    <field name="osvojeniPredispitniPoeni" class="java.lang.Integer"/>
    <field name="osvojeniIspitniPoeni" class="java.lang.Integer"/>
    <field name="ukupnoPoena" class="java.lang.Integer"/>
    <field name="ocena" class="java.lang.Integer"/>
    <field name="ponistio" class="java.lang.Boolean"/>
    <field name="napomena" class="java.lang.String"/>
    
    <title>
        <band height="100">
            <staticText>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="16" isBold="true" pdfFontName="DejaVu Sans" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[ZAPISNIK SA ISPITA]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="40" width="80" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" isBold="true" pdfFontName="DejaVu Sans" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[Predmet:]]></text>
            </staticText>
            <textField>
                <reportElement x="80" y="40" width="475" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" pdfFontName="DejaVu Sans" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{predmetNaziv}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="60" width="80" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" isBold="true" pdfFontName="DejaVu Sans" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[Datum ispita:]]></text>
            </staticText>
            <textField>
                <reportElement x="80" y="60" width="200" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" pdfFontName="DejaVu Sans" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{datumIspita}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="300" y="60" width="80" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" isBold="true" pdfFontName="DejaVu Sans" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[Ispitni rok:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="380" y="60" width="175" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" pdfFontName="DejaVu Sans" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{ispitniRok}]]></textFieldExpression>
            </textField>
        </band>
    </title>
    
    <columnHeader>
        <band height="25">
            <staticText>
                <reportElement x="0" y="0" width="70" height="25"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true" pdfFontName="DejaVu Sans" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[Indeks]]></text>
            </staticText>
            <staticText>
                <reportElement x="70" y="0" width="120" height="25"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true" pdfFontName="DejaVu Sans" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[Ime i prezime]]></text>
            </staticText>
            <staticText>
                <reportElement x="190" y="0" width="60" height="25"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true" pdfFontName="DejaVu Sans" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[Predisp.]]></text>
            </staticText>
            <staticText>
                <reportElement x="250" y="0" width="60" height="25"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true" pdfFontName="DejaVu Sans" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[Ispitni]]></text>
            </staticText>
            <staticText>
                <reportElement x="310" y="0" width="50" height="25"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true" pdfFontName="DejaVu Sans" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[Ukupno]]></text>
            </staticText>
            <staticText>
                <reportElement x="360" y="0" width="40" height="25"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true" pdfFontName="DejaVu Sans" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[Ocena]]></text>
            </staticText>
            <staticText>
                <reportElement x="400" y="0" width="50" height="25"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true" pdfFontName="DejaVu Sans" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[Poništio]]></text>
            </staticText>
            <staticText>
                <reportElement x="450" y="0" width="105" height="25"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true" pdfFontName="DejaVu Sans" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[Napomena]]></text>
            </staticText>
        </band>
    </columnHeader>
    
    <detail>
        <band height="20">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="70" height="20"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" pdfFontName="DejaVu Sans" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{studProgramOznaka} + " " + $F{brojIndeksa} + "/" + $F{godinaIndeksa}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="70" y="0" width="120" height="20"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" pdfFontName="DejaVu Sans" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{studentIme} + " " + $F{studentPrezime}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="190" y="0" width="60" height="20"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" pdfFontName="DejaVu Sans" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{osvojeniPredispitniPoeni}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="250" y="0" width="60" height="20"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" pdfFontName="DejaVu Sans" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{osvojeniIspitniPoeni}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="310" y="0" width="50" height="20"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" pdfFontName="DejaVu Sans" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{ukupnoPoena}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="360" y="0" width="40" height="20"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" pdfFontName="DejaVu Sans" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{ocena}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="400" y="0" width="50" height="20"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" pdfFontName="DejaVu Sans" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{ponistio} ? "Da" : "Ne"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="450" y="0" width="105" height="20"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" pdfFontName="DejaVu Sans" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{napomena}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    
    <pageFooter>
        <band height="50">
            <staticText>
                <reportElement x="0" y="20" width="150" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" pdfFontName="DejaVu Sans" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[Potpis ispitivača: _______________]]></text>
            </staticText>
            <textField>
                <reportElement x="455" y="20" width="100" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" pdfFontName="DejaVu Sans" pdfEncoding="UTF-8" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Strana " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
