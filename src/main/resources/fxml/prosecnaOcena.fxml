<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.raflab.studsluzbadesktopclient.controllers.ProsecnaOcenaController"
            prefHeight="500.0" prefWidth="700.0">

    <top>
        <VBox spacing="0">
            <fx:include source="menuBar.fxml"/>
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 10 20 10 20; -fx-background-color: #f5f5f5;">
                <Button text="← Nazad" onAction="#handleGoBack" style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
                <Label text="Prosečna ocena na predmetu za raspon godina" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 30;">
            <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                <Label text="Izaberite predmet i raspon godina" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="Predmet:" prefWidth="80"/>
                    <ComboBox fx:id="predmetCb" prefWidth="400" promptText="Izaberite predmet"/>
                </HBox>
                
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="Godina od:" prefWidth="80"/>
                    <ComboBox fx:id="godinaOdCb" prefWidth="120" promptText="Od"/>
                    <Label text="Godina do:" prefWidth="80"/>
                    <ComboBox fx:id="godinaDoCb" prefWidth="120" promptText="Do"/>
                </HBox>
                
                <HBox alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
                    <Button text="Izračunaj prosečnu ocenu" onAction="#handleCalculateAverageGrade" 
                            style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 20;"/>
                </HBox>
            </VBox>
            
            <VBox fx:id="resultContainer" spacing="15" 
                  style="-fx-padding: 25; -fx-background-color: #e3f2fd; -fx-background-radius: 10;" 
                  visible="false" managed="false">
                <Label text="Rezultat" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1976D2;"/>
                
                <HBox spacing="30" alignment="CENTER_LEFT">
                    <VBox spacing="5">
                        <Label text="Predmet:" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                        <Label fx:id="resultPredmetLabel" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Period:" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                        <Label fx:id="resultPeriodLabel" style="-fx-font-size: 14px;"/>
                    </VBox>
                </HBox>
                
                <HBox spacing="50" alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
                    <VBox spacing="5" alignment="CENTER">
                        <Label text="Prosečna ocena" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                        <Label fx:id="resultAverageLabel" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #2196F3;"/>
                    </VBox>
                    <VBox spacing="5" alignment="CENTER">
                        <Label text="Broj položenih ispita" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                        <Label fx:id="resultCountLabel" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;"/>
                    </VBox>
                </HBox>
            </VBox>
        </VBox>
    </center>

</BorderPane>
